# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Comma-separated browser origins allowed to call the API.
# Example: https://civicai.example.com,https://www.civicai.example.com
CORS_ORIGINS="http://localhost:5173"

# Optional security tuning. Defaults are suitable for a small deployment.
PORT=3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
ISSUE_RATE_LIMIT_MAX=20
JSON_BODY_LIMIT="25mb"
# Set to true only when running behind one trusted reverse proxy.
TRUST_PROXY=false

# Email configuration
RESEND_API_KEY=
EMAIL_FROM=
